# Escanor Live Trading Engine Environment Variables
# NEVER commit real secrets to version control.

# Exchange Credentials (required only for TESTNET and LIVE modes)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Legacy alias, still accepted if BINANCE_API_SECRET is unset:
BINANCE_SECRET_KEY=

# Live Trading Safety Acknowledgement (REQUIRED to execute live funded orders)
ESCANOR_LIVE_TRADING_ENABLED=false

# Optional custom config path
ESCANOR_CONFIG_PATH=config/live.example.json

# Telegram Alerting (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
